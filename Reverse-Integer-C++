class Solution {
public:
    int reverse(int x) {
        long reversedNum = 0;
        while(x != 0){
        reversedNum *= 10;
        reversedNum += x%10;
        x/=10;
        }
        if (reversedNum>INT_MAX) return 0;
        if (reversedNum<INT_MIN) return 0;
        return reversedNum;
    }
};
