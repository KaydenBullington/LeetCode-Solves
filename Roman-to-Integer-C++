class Solution {
public:
    int romanToInt(string s) {
    
    int num = 0;

    unordered_map<char, int> values = {
    {'I', 1}, {'V', 5}, {'X', 10}, {'L', 50},
    {'C', 100}, {'D', 500}, {'M', 1000}
    };
       
        for(int i = 0; i<s.length(); i++){
            int current = values[s[i]];
            if(i+1 != s.length() && current<values[s[i+1]])
                num-=current;
            else
                num+=current;
        }
    return num;
    }
};
