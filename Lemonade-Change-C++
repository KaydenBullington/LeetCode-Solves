class Solution {
public:
    bool lemonadeChange(vector<int>& bills) {
        
        //keeps track of dollar bills
        int fives=0;
        int tens = 0;
        int twentys = 0;
        int total_amount = 0;

        for(int i = 0; i < bills.size(); i++){
  
            

            switch(bills[i]){
                case 5:
                    fives++;
                    break;
                case 10:
                    tens++;
                    if(fives==0)
                    return(0);
                    else
                    fives--;
                    break;
                case 20:
                    twentys++;
                    if((tens*10+fives*5)>=15 && fives>=1)
                        if(tens>=1){
                            tens--;
                            fives--;
                        }
                        else 
                        fives -= 3;

                    else
                    return(0);
                    
          
            }   
              total_amount = bills[i] + total_amount;
        }
        return(1);
    }
 
};
